---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import GameFilters from '../components/GameFilters.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <GameFilters categories={categories} publishers={publishers} />
          <p class="mb-4 text-sm text-slate-400" data-testid="filter-result-count" role="status" aria-live="polite">
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#game-filters');
  const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');

  function updateResults(): void {
    if (!categoryFilter || !publisherFilter || !grid || !emptyState || !resultCount) return;

    const selectedCategories = new Set(
      [...categoryFilter.selectedOptions].map((option) => option.value),
    );
    const selectedPublisher = publisherFilter.value;
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      const visible = categoryMatches && publisherMatches;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    });

    grid.classList.toggle('hidden', visibleCount === 0);
    emptyState.classList.toggle('hidden', visibleCount !== 0);
    resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
  }

  form?.addEventListener('change', updateResults);
  form?.addEventListener('reset', () => requestAnimationFrame(updateResults));
</script>
